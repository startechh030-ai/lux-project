<?xml version="1.0" encoding="utf-8"?>
<!-- Vexium Premium Gaming Icon - Adaptive Icon for Android -->
<!-- Matches the metallic pink V emblem with dark premium vibe -->

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BACKGROUND LAYER -->
    <!-- Deep black vignette base to match the dark premium background -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#0A0A0A" />
            <!-- Subtle radial gradient for depth -->
            <gradient
                android:type="radial"
                android:centerX="50%"
                android:centerY="50%"
                android:startColor="#1A0A12"
                android:endColor="#050505"
                android:gradientRadius="70%" />
        </shape>
    </item>

    <!-- OUTER GLOW RING -->
    <!-- Subtle pink neon glow so it pops on dark wallpapers -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <stroke
                android:width="1.5dp"
                android:color="#FF2D6A" />
            <solid android:color="#00000000" />
        </shape>
    </item>

    <!-- INNER RING (Gunmetal accent) -->
    <!-- Matches the metallic ring in the logo -->
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="#3A3A3A" />
            <solid android:color="#00000000" />
        </shape>
    </item>

    <!-- TOP ARC HIGHLIGHT -->
    <!-- Matches the silver arc at top of the emblem -->
    <item
        android:left="10dp"
        android:top="6dp"
        android:right="10dp"
        android:bottom="24dp">
        <shape android:shape="arc"
            android:innerRadiusRatio="3"
            android:thickness="3dp"
            android:useLevel="false">
            <solid android:color="#E8E8E8" />
            <gradient
                android:type="linear"
                android:startColor="#FFFFFF"
                android:endColor="#888888"
                android:angle="270" />
        </shape>
    </item>

    <!-- CENTER V EMBLEM -->
    <!-- Main pink metallic V shape -->
    <item
        android:left="18dp"
        android:top="20dp"
        android:right="18dp"
        android:bottom="16dp">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <!-- Outer V layer -->
            <path
                android:fillColor="#FF2D6A"
                android:strokeColor="#FF6B9D"
                android:strokeWidth="1"
                android:pathData="M54,28 L72,52 L64,52 L54,38 L44,52 L36,52 Z" />
            <!-- Middle V layer -->
            <path
                android:fillColor="#FF4D80"
                android:strokeColor="#FF8FB0"
                android:strokeWidth="0.8"
                android:pathData="M54,40 L66,58 L60,58 L54,48 L48,58 L42,58 Z" />
            <!-- Inner V layer -->
            <path
                android:fillColor="#FF6B9D"
                android:strokeColor="#FFB8D4"
                android:strokeWidth="0.6"
                android:pathData="M54,50 L62,64 L58,64 L54,56 L50,64 L46,64 Z" />
            <!-- Specular highlight on left edge -->
            <path
                android:fillColor="#FFFFFF"
                android:fillAlpha="0.4"
                android:pathData="M54,28 L58,34 L54,30 L50,34 Z" />
        </vector>
    </item>

    <!-- BOTTOM SHADOW/GLOW -->
    <!-- Warm orange-gold edge lighting at bottom -->
    <item
        android:left="20dp"
        android:top="60dp"
        android:right="20dp"
        android:bottom="10dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="50%"
                android:centerY="0%"
                android:startColor="#FF8C42"
                android:endColor="#00000000"
                android:gradientRadius="40%" />
        </shape>
    </item>

</layer-list>